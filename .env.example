# Copy to .env (or set these in your server / Docker config). Not needed for local dev.
PUMPZONE_SECRET_KEY=replace-with-a-long-random-string
PUMPZONE_DEBUG=0
PUMPZONE_ALLOWED_HOSTS=pumpzone.example.com
PUMPZONE_DATA_DIR=/srv/pumpzone/data
PUMPZONE_GRACE_DAYS=3
# The gym's real GCash QR image (GCash app > Receive > QR). Blank = demo QR.
PUMPZONE_GCASH_QR_IMAGE=/srv/pumpzone/data/gcash-qr.png
